---
// Bandeau de consentement à la mesure d'audience.
//
// Volontairement sans script : toute la logique (affichage, mémorisation du
// choix, chargement de gtag.js) vit dans <GoogleAnalytics />, qui écoute les
// clics en délégation. Le bandeau est donc du balisage pur, masqué par défaut
// et révélé côté client seulement si aucun choix valide n'est mémorisé — ce qui
// évite qu'il n'apparaisse puis disparaisse chez les visiteurs déjà décidés.
import { GA_MEASUREMENT_ID } from "src/consts";
---

{
  GA_MEASUREMENT_ID && (
    <div
      id="cookie-consent"
      role="dialog"
      aria-labelledby="cookie-consent-title"
      aria-describedby="cookie-consent-description"
      hidden
      class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-lg border-1 border-black bg-pyellow p-6 shadow-card md:inset-x-auto md:right-6 md:bottom-6"
    >
      <h2 id="cookie-consent-title" class="text-lg font-semibold">
        Cookies de mesure d'audience
      </h2>
      <p id="cookie-consent-description" class="mt-2 text-sm">
        J'utilise Google Analytics pour savoir quelles pages sont consultées.
        Rien n'est collecté tant que vous n'avez pas accepté, et votre choix est
        conservé six mois. Détails dans la{" "}
        <a
          href="/politique-de-confidentialite"
          class="underline underline-offset-2 hover:no-underline"
        >
          politique de confidentialité
        </a>.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button
          type="button"
          data-consent="denied"
          class="flex-1 rounded-lg border-1 border-black bg-white px-5 py-3 cursor-pointer shadow-card1 transition hover:shadow-card"
        >
          Refuser
        </button>
        <button
          type="button"
          data-consent="granted"
          class="flex-1 rounded-lg border-1 border-black bg-pgreen px-5 py-3 cursor-pointer shadow-card1 transition hover:shadow-card"
        >
          Accepter
        </button>
      </div>
    </div>
  )
}
