---
const today = new Date();
import { Icon } from "astro-icon/components";
import CookieConsent from "@/components/CookieConsent.astro";
import { GA_MEASUREMENT_ID } from "src/consts";
---

<footer
    class="flex flex-col items-center container mx-auto p-10 text-center gap-10 pb-16"
>
    &copy; {today.getFullYear()} Louis SACHY
    <div class="flex items-center gap-6 text-5xl">
        <div class="border-1 p-1 border-black rounded-md bg-pblue shadow-card hover:shadow-hover transition">
            <a
                href="https://www.linkedin.com/in/louis-sachy/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Profil LinkedIn de Louis SACHY (nouvel onglet)"
            >
                <Icon name="linkedin" size="45" aria-hidden="true" />
            </a>
        </div>
        <a
            href="https://www.malt.fr/profile/louissachy"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Profil Malt de Louis SACHY (nouvel onglet)"
            class="border-1 p-1 border-black rounded-full bg-malt shadow-card hover:shadow-hover transition"
        >
            <Icon name="malt" size="50" aria-hidden="true" />
        </a>
        <a
            href="https://github.com/Loot1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Profil GitHub de Louis SACHY (nouvel onglet)"
            class="border-1 p-1 border-black rounded-full bg-pgreen shadow-card hover:shadow-hover transition"
        >
            <Icon name="github" size="50" aria-hidden="true" />
        </a>
        <a
            href="https://gitlab.com/Loot1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Profil GitLab de Louis SACHY (nouvel onglet)"
            class="border-1 p-1 border-black rounded-full bg-pyellow shadow-card hover:shadow-hover transition"
        >
            <Icon name="gitlab" size="50" aria-hidden="true" />
        </a>
    </div>
    <nav
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-pblack"
        aria-label="Informations légales"
    >
        <a href="/mentions-legales" class="underline underline-offset-4 hover:no-underline">
            Mentions légales
        </a>
        <span aria-hidden="true">&middot;</span>
        <a
            href="/politique-de-confidentialite"
            class="underline underline-offset-4 hover:no-underline"
        >
            Politique de confidentialité
        </a>
        {
            GA_MEASUREMENT_ID && (
                <Fragment>
                    <span aria-hidden="true">&middot;</span>
                    <button
                        type="button"
                        data-consent="settings"
                        class="cursor-pointer underline underline-offset-4 hover:no-underline"
                    >
                        Gestion des cookies
                    </button>
                </Fragment>
            )
        }
    </nav>
</footer>

<CookieConsent />
