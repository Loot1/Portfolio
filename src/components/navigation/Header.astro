---
import Link from "./HeaderLink.astro";
import "../../styles/hamburgers.css";
import { NAVIGATION } from "src/consts";
---

<header>
    <nav
        class="flex container mx-auto md:p-10 px-4 py-6 items-center justify-between"
        aria-label="Navigation principale"
    >
        <a class="flex items-center gap-2" href="/" aria-label="Louis Sachy - Accueil">
            <p class="font-kablamo text-ppink text-4xl md:text-5xl" aria-hidden="true">L</p>
            <p class="pt-2 md:text-lg font-semibold flex">
                <span class="hidden md:block">Louis</span> Sachy
            </p>
        </a>
        <ul class="items-center md:gap-8 text-nowrap hidden md:flex">
            {
                NAVIGATION.map((item) => (
                    <li>
                        <Link
                            href={item.href}
                            text={item.text}
                            style={item.style}
                        />
                    </li>
                ))
            }
        </ul>
        <div class="md:hidden z-40">
            <button
                class="hamburger hamburger--elastic"
                type="button"
                aria-label="Ouvrir le menu"
                aria-expanded="false"
                aria-controls="navigation"
            >
                <span class="hamburger-box" aria-hidden="true">
                    <span class="hamburger-inner"></span>
                </span>
            </button>

            <div
                id="navigation"
                inert
                class="fixed top-0 left-0 w-full h-full bg-white transform -translate-y-full transition-transform duration-300 ease-in-out"
            >
                <ul
                    class="flex flex-col items-center justify-center h-full gap-8 text-nowrap"
                >
                    {
                        NAVIGATION.map((item) => (
                            <li>
                                <Link
                                    href={item.href}
                                    text={item.text}
                                    style={item.style}
                                />
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<script is:inline>
    function init() {
        const hamburger = document.querySelector(".hamburger");
        const menu = document.getElementById("navigation");

        if (hamburger && menu) {
            hamburger.addEventListener("click", () => {
                hamburger.classList.toggle("is-active");
                menu.classList.toggle("-translate-y-full");
                menu.classList.toggle("translate-y-0");

                const isOpen = !menu.classList.contains("-translate-y-full");
                // Le menu fermé reste dans le flux, décalé hors écran : `inert`
                // l'exclut du clavier et des lecteurs d'écran.
                menu.inert = !isOpen;
                hamburger.setAttribute("aria-expanded", String(isOpen));
                hamburger.setAttribute(
                    "aria-label",
                    isOpen ? "Fermer le menu" : "Ouvrir le menu",
                );
            });
        }
    }
    init();
    document.addEventListener("astro:after-swap", init);
</script>
