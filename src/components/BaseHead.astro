---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

import { ClientRouter } from "astro:transitions";
import { SITE_TITLE } from "src/consts";
import defaultSocialImage from "../assets/photo-louis-sachy.jpg";
import GoogleAnalytics from "./GoogleAnalytics.astro";

const { title, description, image = defaultSocialImage.src } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = new URL(image, Astro.site ?? Astro.url);

// Certaines pages passent une description en HTML (elle est aussi rendue dans
// le corps de la page) : les balises meta doivent recevoir du texte brut.
// Chaque page doit avoir un titre unique : on suffixe le nom du site, sauf
// sur l'accueil dont le titre est déjà celui du site.
const pageTitle = title === SITE_TITLE ? title : `${title} - ${SITE_TITLE}`;

const metaDescription = description
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/Alexandria-Light.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Alexandria-Regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Alexandria-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Alexandria-Bold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Kablammo-Subset.woff2" as="font" type="font/woff2" crossorigin />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<ClientRouter />
<meta name="title" content={pageTitle} />
<meta name="description" content={metaDescription} />

<!-- Flux RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} - Projets`}
  href={new URL("rss.xml", Astro.site ?? Astro.url)}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={pageTitle} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={metaDescription} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:image:alt" content={pageTitle} />

<!-- Google Analytics -->
<GoogleAnalytics />
